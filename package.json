{
  "name": "qtr-mac",
  "productName": "QTR",
  "version": "0.1.0",
  "description": "QTR, a desk for a beautiful quarter, as a Mac app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac --arm64 -c.mac.identity=null -c.mac.notarize=false --publish never",
    "release": "electron-builder --mac --publish always"
  },
  "build": {
    "appId": "ai.qtr.desktop",
    "productName": "QTR",
    "icon": "build/icon.icns",
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "protocols": [
      {
        "name": "QTR",
        "schemes": [
          "qtr"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "qtr-ai",
        "repo": "qtr-mac",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
